APP_NAME=NCLEX Daily API
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://nclex:nclex_local_password@localhost:5432/nclex_daily
DATABASE_SERVERLESS=false
CORS_ORIGINS=http://localhost:5173

# For Vercel, use the Supabase Transaction pooler URL, set
# DATABASE_SERVERLESS=true, and set APP_ENV=production. CORS_ORIGINS must be
# the exact deployed frontend origin (no trailing slash).

# Supabase Auth (backend-safe public project settings)
# Find these in Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
